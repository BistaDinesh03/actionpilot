# Optional configuration for ActionPilot. The backend loads this file from
# the repository root at startup; variables already set in your shell
# environment always win. Placeholders only — never commit real credentials.

# Gmail integration (Google OAuth desktop client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Optional AI provider settings (read by the AI config; no AI traffic
# originates unless a provider is explicitly wired in).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Runtime tuning (defaults shown).
# MAX_AGENT_STEPS=15
# ACTIONPILOT_HEADLESS=1
# VSCODE_PATH=Code.exe
